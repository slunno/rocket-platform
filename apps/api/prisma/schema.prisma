generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ONLINE
  BUSY
  DO_NOT_DISTURB
  AWAY
  OFFLINE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ChannelVisibility {
  PUBLIC
  PRIVATE
}

enum NotificationKind {
  MENTION
  REPLY
  REACTION
  INVITE
  EVENT_REMINDER
}

enum NotificationLevel {
  ALL
  MENTIONS
  MUTED
}

enum CalendarRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum CalendarAttendeeStatus {
  INVITED
  ACCEPTED
  DECLINED
}

model User {
  id                     String                  @id @default(cuid())
  username               String                  @unique
  displayName            String
  email                  String?                 @unique
  passwordHash           String?
  avatarUrl              String?
  jobTitle               String?
  timeZone               String                  @default("America/Sao_Paulo")
  locale                 String                  @default("pt-BR")
  status                 UserStatus              @default(OFFLINE)
  statusMessage          String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  workspaceMemberships   WorkspaceMember[]
  conversations          ConversationMember[]
  createdConversations   Conversation[]          @relation("ConversationCreator")
  messages               Message[]
  reactions              Reaction[]
  authSessions           AuthSession[]
  passwordResetTokens    PasswordResetToken[]
  teamMemberships        TeamMember[]
  channelMemberships     ChannelMember[]
  channelReadStates      ChannelReadState[]
  channelPreferences     ChannelPreference[]
  receivedNotifications  ActivityNotification[]  @relation("NotificationRecipient")
  sentNotifications      ActivityNotification[]  @relation("NotificationActor")
  pushSubscriptions      PushSubscription[]
  invitesSent            WorkspaceInvite[]       @relation("InviteCreator")
  invitesAccepted        WorkspaceInvite[]       @relation("InviteAccepter")
  calendarEventsCreated  CalendarEvent[]         @relation("CalendarEventCreator")
  calendarAttendance     CalendarEventAttendee[]
  meetingCallsCreated    MeetingCall[]           @relation("MeetingCallCreator")
  meetingCallMemberships CallParticipant[]
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  familyId         String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
}

model AuthThrottle {
  key             String    @id
  failedCount     Int       @default(0)
  windowStartedAt DateTime
  lockedUntil     DateTime?
  updatedAt       DateTime  @updatedAt
}

model Workspace {
  id             String                 @id @default(cuid())
  name           String
  slug           String                 @unique
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  members        WorkspaceMember[]
  teams          Team[]
  invites        WorkspaceInvite[]
  conversations  Conversation[]
  notifications  ActivityNotification[]
  calendarEvents CalendarEvent[]
  meetingCalls   MeetingCall[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Conversation {
  id            String                 @id @default(cuid())
  type          ConversationType
  name          String
  description   String?
  avatarUrl     String?
  workspaceId   String?
  directKey     String?                @unique
  createdById   String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  workspace     Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdBy     User?                  @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members       ConversationMember[]
  messages      Message[]
  notifications ActivityNotification[]
  meetingCalls  MeetingCall[]

  @@index([workspaceId, type, updatedAt])
  @@index([updatedAt])
}

model Team {
  id          String            @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  archivedAt  DateTime?
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  channels    Channel[]
  invites     WorkspaceInvite[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, archivedAt])
}

model TeamMember {
  teamId   String
  userId   String
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

model Channel {
  id            String                 @id @default(cuid())
  teamId        String
  name          String
  slug          String
  description   String?
  visibility    ChannelVisibility      @default(PUBLIC)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  archivedAt    DateTime?
  team          Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members       ChannelMember[]
  preferences   ChannelPreference[]
  messages      Message[]
  readStates    ChannelReadState[]
  notifications ActivityNotification[]
  meetingCalls  MeetingCall[]

  @@unique([teamId, slug])
  @@index([teamId, visibility, archivedAt])
}

model ChannelMember {
  channelId String
  userId    String
  joinedAt  DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

model ChannelReadState {
  channelId  String
  userId     String
  lastReadAt DateTime @default(now())
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId, lastReadAt])
}

model ChannelPreference {
  channelId         String
  userId            String
  favorite          Boolean           @default(false)
  hidden            Boolean           @default(false)
  notificationLevel NotificationLevel @default(ALL)
  updatedAt         DateTime          @updatedAt
  channel           Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId, favorite, hidden])
}

model ActivityNotification {
  id             String           @id @default(cuid())
  recipientId    String
  actorId        String?
  kind           NotificationKind
  sourceKey      String
  workspaceId    String?
  conversationId String?
  channelId      String?
  messageId      String?
  createdAt      DateTime         @default(now())
  readAt         DateTime?
  recipient      User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor          User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspace      Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation?    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel        Channel?         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message        Message?         @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([recipientId, sourceKey])
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.Text
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkspaceInvite {
  id           String        @id @default(cuid())
  workspaceId  String
  teamId       String?
  email        String
  role         WorkspaceRole
  tokenHash    String        @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  canceledAt   DateTime?
  invitedById  String
  acceptedById String?
  createdAt    DateTime      @default(now())
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  invitedBy    User          @relation("InviteCreator", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy   User?         @relation("InviteAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email, acceptedAt, canceledAt])
  @@index([expiresAt])
}

model ConversationMember {
  conversationId    String
  userId            String
  joinedAt          DateTime          @default(now())
  lastReadAt        DateTime?
  muted             Boolean           @default(false)
  pinned            Boolean           @default(false)
  notificationLevel NotificationLevel @default(ALL)
  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, joinedAt])
}

model Message {
  id                    String                 @id @default(cuid())
  conversationId        String?
  channelId             String?
  authorId              String
  text                  String                 @db.Text
  clientMessageId       String?                @db.Uuid
  replyToId             String?
  createdAt             DateTime               @default(now())
  editedAt              DateTime?
  deletedAt             DateTime?
  conversation          Conversation?          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel               Channel?               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author                User                   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  replyTo               Message?               @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies               Message[]              @relation("MessageReplies")
  attachments           Attachment[]
  reactions             Reaction[]
  activityNotifications ActivityNotification[]

  @@unique([conversationId, authorId, clientMessageId])
  @@unique([channelId, authorId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([channelId, createdAt])
  @@index([authorId, createdAt])
  @@index([replyToId])
}

model Attachment {
  id         String    @id @default(cuid())
  messageId  String
  fileName   String
  mimeType   String
  sizeBytes  BigInt
  storageKey String
  uploadedAt DateTime?
  createdAt  DateTime  @default(now())
  message    Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Reaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([messageId])
}

model CalendarEvent {
  id              String                  @id @default(cuid())
  workspaceId     String
  createdById     String
  title           String
  description     String?                 @db.Text
  startAt         DateTime
  endAt           DateTime
  timeZone        String                  @default("America/Sao_Paulo")
  recurrence      CalendarRecurrence      @default(NONE)
  recurrenceUntil DateTime?
  reminderMinutes Int                     @default(15)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?
  workspace       Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User                    @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  attendees       CalendarEventAttendee[]
  meetingCall     MeetingCall?

  @@index([workspaceId, startAt, endAt])
  @@index([workspaceId, recurrence, recurrenceUntil])
}

model CalendarEventAttendee {
  eventId     String
  userId      String
  status      CalendarAttendeeStatus @default(INVITED)
  respondedAt DateTime?
  createdAt   DateTime               @default(now())
  event       CalendarEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId, status])
}

model MeetingCall {
  id             String            @id @default(cuid())
  workspaceId    String
  conversationId String?
  channelId      String?
  eventId        String?           @unique
  roomName       String            @unique
  createdById    String
  startedAt      DateTime          @default(now())
  endedAt        DateTime?
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  channel        Channel?          @relation(fields: [channelId], references: [id], onDelete: SetNull)
  event          CalendarEvent?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy      User              @relation("MeetingCallCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants   CallParticipant[]

  @@index([workspaceId, startedAt])
  @@index([conversationId, startedAt])
  @@index([channelId, startedAt])
}

model CallParticipant {
  callId        String
  userId        String
  firstJoinedAt DateTime    @default(now())
  lastJoinedAt  DateTime    @default(now())
  leftAt        DateTime?
  call          MeetingCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([callId, userId])
  @@index([userId, lastJoinedAt])
}
