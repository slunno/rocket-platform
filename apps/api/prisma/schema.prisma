generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ONLINE
  BUSY
  DO_NOT_DISTURB
  AWAY
  OFFLINE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ChannelVisibility {
  PUBLIC
  PRIVATE
}

model User {
  id                   String               @id @default(cuid())
  username             String               @unique
  displayName          String
  email                String?              @unique
  passwordHash         String?
  avatarUrl            String?
  jobTitle             String?
  timeZone             String               @default("America/Sao_Paulo")
  locale               String               @default("pt-BR")
  status               UserStatus           @default(OFFLINE)
  statusMessage        String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  workspaceMemberships WorkspaceMember[]
  conversations        ConversationMember[]
  messages             Message[]
  reactions            Reaction[]
  authSessions         AuthSession[]
  passwordResetTokens  PasswordResetToken[]
  teamMemberships      TeamMember[]
  channelMemberships   ChannelMember[]
  channelPreferences   ChannelPreference[]
  invitesSent          WorkspaceInvite[]   @relation("InviteCreator")
  invitesAccepted      WorkspaceInvite[]   @relation("InviteAccepter")
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  familyId         String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
}

model AuthThrottle {
  key             String    @id
  failedCount     Int       @default(0)
  windowStartedAt DateTime
  lockedUntil     DateTime?
  updatedAt       DateTime  @updatedAt
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   WorkspaceMember[]
  teams     Team[]
  invites   WorkspaceInvite[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Conversation {
  id          String               @id @default(cuid())
  type        ConversationType
  name        String
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     ConversationMember[]
  messages    Message[]

  @@index([updatedAt])
}

model Team {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  archivedAt  DateTime?
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  channels    Channel[]
  invites     WorkspaceInvite[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, archivedAt])
}

model TeamMember {
  teamId   String
  userId   String
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

model Channel {
  id          String            @id @default(cuid())
  teamId      String
  name        String
  slug        String
  description String?
  visibility  ChannelVisibility @default(PUBLIC)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  archivedAt  DateTime?
  team        Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members     ChannelMember[]
  preferences ChannelPreference[]
  messages    Message[]

  @@unique([teamId, slug])
  @@index([teamId, visibility, archivedAt])
}

model ChannelMember {
  channelId String
  userId    String
  joinedAt  DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

model ChannelPreference {
  channelId String
  userId    String
  favorite  Boolean  @default(false)
  hidden    Boolean  @default(false)
  updatedAt DateTime @updatedAt
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId, favorite, hidden])
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  teamId      String?
  email       String
  role        WorkspaceRole
  tokenHash   String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  canceledAt  DateTime?
  invitedById String
  acceptedById String?
  createdAt   DateTime      @default(now())
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  invitedBy   User         @relation("InviteCreator", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy  User?        @relation("InviteAccepter", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email, acceptedAt, canceledAt])
  @@index([expiresAt])
}

model ConversationMember {
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, joinedAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String?
  channelId      String?
  authorId       String
  text           String        @db.Text
  replyToId      String?
  createdAt      DateTime      @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel        Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author         User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  replyTo        Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]     @relation("MessageReplies")
  attachments    Attachment[]
  reactions      Reaction[]

  @@index([conversationId, createdAt])
  @@index([channelId, createdAt])
  @@index([authorId, createdAt])
  @@index([replyToId])
}

model Attachment {
  id         String   @id @default(cuid())
  messageId  String
  fileName   String
  mimeType   String
  sizeBytes  BigInt
  storageKey String
  createdAt  DateTime @default(now())
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Reaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@index([messageId])
}
