{
  "name": "@rocket/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-presigned-post": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@rocket/shared": "*",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.19.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/web-push": "^3.6.4",
    "prisma": "^7.10.1",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
